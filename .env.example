# Copy to `.env` next to the compose file and fill in. Never commit the filled copy.

# From https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Pin a versioned model once you rely on its probabilities, so they do not shift
# under you when `jev-latest` moves. List them: GET https://api.typesafe.ai/v1/models
# JEV_MODEL=jev-latest

# JEV_MCP_ALLOWED_HOSTS=jev-mcp
# JEV_MCP_LOG_LEVEL=INFO
